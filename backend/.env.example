# winserver 운영 시 backend/.env 로 복사 후 값 채움 (레포 커밋 금지)
# DB는 설문 전용 인스턴스 mongod-survey(네트워크 survey-net). 2026-09-12 ALRIS 공유 mongod에서 이관했다.
# 계정은 이 DB만 읽고 쓰는 앱 계정 gwacheon_ahp_survey_app. 값은 운영자 시크릿 저장소의 container.uri 파일에서 가져온다.
MONGODB_URI=mongodb://gwacheon_ahp_survey_app:<password>@mongod-survey:27017/?authSource=admin&directConnection=true
MONGODB_DB=gwacheon_ahp_survey
TOKEN_SECRET=<랜덤 64자>
ADMIN_KEY=<관리자 키>
CORS_ORIGINS=https://burn001.github.io
GMAIL_USER=llm.dev.auri@gmail.com
GMAIL_APP_PASSWORD=
SURVEY_BASE_URL=https://burn001.github.io/gwacheon-ahp-survey/
